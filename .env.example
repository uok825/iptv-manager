# Public URL shown in the UI for TiviMate (your Cloudflare tunnel domain)
# Example: https://iptv.yourdomain.com
PUBLIC_URL=

# Port to run on (default: 7345)
PORT=7345

# EPG (Electronic Program Guide) URL — included in playlist for TiviMate
EPG_URL=https://epgshare01.online/epgshare01/epg_ripper_TR1.xml.gz

# How often to sync upstream M3U sources (in days)
SYNC_INTERVAL_DAYS=7
